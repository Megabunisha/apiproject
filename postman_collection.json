    },
    {
      "name": "7. Error Test: Non-Existent Post (Expect 404)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "http://localhost:5000/posts/post-999999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
