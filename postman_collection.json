        "url": {
          "raw": "http://localhost:5000/posts",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["posts"]
        },
        "description": "Tests input validation. Expects 400 Bad Request with field errors array."
